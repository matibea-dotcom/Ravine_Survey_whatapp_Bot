# ---- Meta WhatsApp Cloud API ----
WHATSAPP_TOKEN=your_permanent_or_temporary_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_here
WHATSAPP_API_VERSION=v20.0

# ---- Google Sheets ----
# Path to the service-account JSON key file (see README for setup)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_SHEET_ID=the_id_from_your_sheet_url
GOOGLE_SHEET_TAB=Submissions

# ---- App ----
PORT=3000
SESSION_TIMEOUT_MINUTES=30
SESSION_WARNING_MINUTES=25
SESSION_RESUME_WINDOW_HOURS=24
