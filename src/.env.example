# ---- Meta WhatsApp Cloud API ----
WHATSAPP_TOKEN=your_permanent_or_temporary_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_here
WHATSAPP_API_VERSION=v20.0

# ---- Google Sheets ----
# Path to the service-account JSON key file (see README for setup)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_SHEET_ID=the_id_from_your_sheet_url

# Agents tab (registration records)
GOOGLE_SHEET_TAB_AGENTS=Agents

# Stores tab (MT store registry — Phase 1)
GOOGLE_SHEET_TAB_STORES=Stores

# Each survey track writes to its own Submissions tab. GT defaults to your
# existing "Submissions" tab so historical data isn't split. Override any of
# these if you want different tab names.
GOOGLE_SHEET_TAB_GT=Submissions
GOOGLE_SHEET_TAB_MT=MT_Submissions
GOOGLE_SHEET_TAB_INSURANCE=Insurance_Submissions

# ---- Admin access (comma-separated WhatsApp IDs, no +, no spaces) ----
ADMIN_WA_IDS=254700000000,254799999999

# ---- App ----
PORT=3000
SESSION_TIMEOUT_MINUTES=30
SESSION_WARNING_MINUTES=25
SESSION_RESUME_WINDOW_HOURS=24

# Optional: comma-separated words for the basic offensive-language screen
OFFENSIVE_TERMS=
